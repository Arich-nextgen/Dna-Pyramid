{
  "name": "pyramid-dna-workstation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepare:python": "python3 ../scripts/prepare_runtime.py",
    "build:vercel": "tsc -b && VITE_BROWSER_PYTHON=true vite build --outDir ../dist",
    "build:site": "pnpm run prepare:python && tsc -b && VITE_BROWSER_PYTHON=true vite build --outDir ../dist",
    "test:python": "cd .. && node tests/test_browser_python.mjs",
    "test:text-import": "node --experimental-strip-types tests/test_text_import.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.35.0",
    "pyodide": "0.29.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.0"
  }
}
